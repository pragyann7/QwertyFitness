<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/shape_widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Streak and Title -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_img_streak"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_streak_fire" />

            <TextView
                android:id="@+id/widget_text_streak_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textColor="@color/accent_electric_lime"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="DAILY GOALS"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </RelativeLayout>

    <!-- Progress Bars -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <!-- Calories -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calories"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_text_calories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0/0"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/widget_progress_calories"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="@drawable/shape_widget_progress_calories"
            android:max="100"
            android:progress="0" />

        <!-- Protein -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Protein"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_text_protein"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0/0"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/widget_progress_protein"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="@drawable/shape_widget_progress_protein"
            android:max="100"
            android:progress="0" />

        <!-- Water -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Water"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_text_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="0/0"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </RelativeLayout>
        <ProgressBar
            android:id="@+id/widget_progress_water"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:progressDrawable="@drawable/shape_widget_progress_water"
            android:max="100"
            android:progress="0" />

    </LinearLayout>

    <!-- Shortcut -->
    <TextView
        android:id="@+id/widget_btn_start"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/shape_widget_button"
        android:gravity="center"
        android:text="START WORKOUT"
        android:textColor="@color/background_deep_charcoal"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
