<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_slate"
    app:cardCornerRadius="16dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/text_session_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Push Day"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_session_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2023-10-27"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_session_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4,850 kg"
                android:textColor="@color/highlight_soft_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="16dp"
                android:layout_height="0dp" />

            <TextView
                android:id="@+id/text_session_sets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22 sets"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>