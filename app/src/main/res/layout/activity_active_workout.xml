<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_deep_charcoal">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_slate"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Active Workout"
        app:titleTextColor="@color/text_primary">
        <ImageButton
            android:id="@+id/btn_add_exercise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_workout"
            app:tint="@color/accent_electric_lime" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_active_exercises"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layout_timer_presets"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <HorizontalScrollView
        android:id="@+id/layout_timer_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_slate"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toTopOf="@id/layout_timer">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_30s"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30s"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/divider_slate" />
            <View android:layout_width="8dp" android:layout_height="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_60s"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60s"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/divider_slate" />
            <View android:layout_width="8dp" android:layout_height="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_90s"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90s"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/divider_slate" />
            <View android:layout_width="8dp" android:layout_height="0dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_180s"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3m"
                android:textSize="12sp"
                app:cornerRadius="20dp"
                app:strokeColor="@color/divider_slate" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layout_timer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_slate"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btn_finish_workout">

        <TextView
            android:id="@+id/text_timer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REST"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_rest_timer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="01:30"
            android:textColor="@color/accent_electric_lime"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_skip_timer"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SKIP"
            android:textColor="@color/error_coral_red" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_finish_workout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="FINISH WORKOUT"
        android:textColor="@color/background_deep_charcoal"
        app:backgroundTint="@color/accent_electric_lime"
        app:cornerRadius="8dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>