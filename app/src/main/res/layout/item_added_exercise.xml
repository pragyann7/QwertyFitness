<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/text_exercise_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edit_target_sets"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:background="@color/surface_elevated_soft_slate"
        android:gravity="center"
        android:hint="Sets"
        android:inputType="number"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/edit_target_reps"
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="4dp"
        android:background="@color/surface_elevated_soft_slate"
        android:gravity="center"
        android:hint="Reps"
        android:inputType="text"
        android:padding="8dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/btn_remove"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Remove exercise"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="@color/error_coral_red" />

</LinearLayout>