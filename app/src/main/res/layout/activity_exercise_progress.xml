<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_deep_charcoal">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_slate"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextColor="@color/text_primary" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_graph"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/surface_slate"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:strokeWidth="0dp">

        <com.ps.qwertyfitness.ui.progress.TrendGraphView
            android:id="@+id/exercise_graph"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/text_history_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="HISTORY"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_graph" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_exercise_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_history_label" />

</androidx.constraintlayout.widget.ConstraintLayout>